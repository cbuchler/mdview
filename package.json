{
  "name": "mdview",
  "version": "0.2.1",
  "private": false,
  "description": "Terminal markdown previewer with live reload",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "mdview": "dist/main.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "completions"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-native.mjs",
    "dev": "npm run build && tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:binaries": "node scripts/build-binary.mjs",
    "install:binary": "node scripts/install-binary.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.82",
    "chokidar": "^4.0.3",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "string-width": "^7.2.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "react-devtools-core": "^4.28.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}

class MdviewLinuxSandboxRequirement < Requirement
  fatal true

  satisfy(build_env: false) do
    File.executable?("/usr/bin/bwrap") && File.executable?("/usr/bin/systemd-run")
  end

  def message
    "Install distro Bubblewrap and systemd user-session support. mdview also needs cgroup v2 memory/task controls."
  end
end

class Mdview < Formula
  desc "Terminal Markdown viewer with history and live reload"
  homepage "https://github.com/cbuchler/mdview"
  url "https://github.com/cbuchler/mdview/archive/@REF@.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "GPL-3.0-or-later"

  depends_on "node@22" => :build
  depends_on macos: :tahoe if OS.mac?
  depends_on MdviewLinuxSandboxRequirement if OS.linux?

  resource "bun" do
    version "1.4.4"
    target = "#{OS.mac? ? "darwin" : "linux"}-#{Hardware::CPU.arm? ? "aarch64" : "x64"}"
    url "https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-#{target}.zip"
    sha256({
      "darwin-aarch64" => "c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510",
      "darwin-x64" => "50a3491f73abc2fe81673171a85762d3bc2cc1680ccecadd983de99adf77977e",
      "linux-aarch64" => "baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e",
      "linux-x64" => "bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c",
    }.fetch(target))
  end

  def fetch
    ENV["npm_config_cache"] = buildpath/".npm-cache"
    system "npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"
  end

  def install
    ENV["npm_config_cache"] = buildpath/".npm-cache"
    resource("bun").stage { (buildpath/"bun-build").install "bun" }
    ENV.prepend_path "PATH", buildpath/"bun-build"
    system "npm", "ci", "--offline", "--ignore-scripts", "--no-audit", "--no-fund"
    system "npm", "run", "build"
    system "npm", "run", "package:binaries"
    bin.install "release/mdview"
    doc.install "THIRD_PARTY_NOTICES.md"
    bash_completion.install "completions/bash/mdview"
    zsh_completion.install "completions/zsh/_mdview"
    fish_completion.install "completions/fish/mdview.fish"
  end

  def caveats
    <<~EOS
      Rendering requires OS sandbox and memory controls. Linux needs distro
      Bubblewrap, a systemd user manager and cgroup v2 memory/task controllers.
      macOS uses private Apple memory APIs and Seatbelt. Unsupported hosts
      refuse rendering; protection is never disabled automatically.
    EOS
  end

  test do
    (testpath/"document.md").write "# Homebrew render\n\nInstalled from the formula.\n"
    # Homebrew already sandboxes this fixed fixture; CI separately verifies default protection.
    assert_match "Homebrew render", shell_output("#{bin}/mdview --no-sandbox --no-history #{testpath}/document.md")
  end
end

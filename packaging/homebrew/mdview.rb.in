class MdviewLinuxToolsRequirement < Requirement
  fatal true

  satisfy(build_env: false) do
    File.executable?("/usr/bin/ldd") && %w[bwrap systemd-run].all? do |name|
      ENV.fetch("PATH", "/usr/bin:/bin").split(File::PATH_SEPARATOR).any? do |directory|
        Pathname.new(directory).absolute? && File.executable?(File.join(directory, name))
      end
    end
  end

  def message
    "Provide bwrap and systemd-run on absolute PATH entries, and /usr/bin/ldd. " \
      "This checks executable availability only; mdview checks namespace, user-session, and cgroup controls when rendering."
  end
end

class Mdview < Formula
  desc "Terminal Markdown viewer with history and live reload"
  homepage "https://github.com/cbuchler/mdview"
  url "https://github.com/cbuchler/mdview/archive/@REF@.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"
  license "GPL-3.0-or-later"

  depends_on macos: :tahoe if OS.mac?
  depends_on MdviewLinuxToolsRequirement if OS.linux?

  # Pin the build tool independently of Homebrew's macOS Intel dependency bottles.
  resource "node" do
    version "22.23.4"
    target = "#{OS.mac? ? "darwin" : "linux"}-#{Hardware::CPU.arm? ? "arm64" : "x64"}"
    url "https://nodejs.org/dist/v22.23.4/node-v22.23.4-#{target}.tar.gz"
    sha256({
      "darwin-arm64" => "c9e1dbc748b33ed2d14f42445191ecaf14c56259c7a9a26d0042c49ec2b66428",
      "darwin-x64" => "efcc2b0db6f94bf53eddb038fe2b370277a042bd29e4f19b8f8e23598795b819",
      "linux-arm64" => "f7a1e486dbc8b286847815b477d4fb5e9fb963ed4489c3e1588853d685f589f9",
      "linux-x64" => "b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406",
    }.fetch(target))
  end

  resource "bun" do
    version "1.4.4"
    target = "#{OS.mac? ? "darwin" : "linux"}-#{Hardware::CPU.arm? ? "aarch64" : "x64"}"
    url "https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-#{target}.zip"
    sha256({
      "darwin-aarch64" => "c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510",
      "darwin-x64" => "50a3491f73abc2fe81673171a85762d3bc2cc1680ccecadd983de99adf77977e",
      "linux-aarch64" => "baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e",
      "linux-x64" => "bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c",
    }.fetch(target))
  end

  def fetch
    resource("node").stage { (buildpath/"node-build").install Dir["*"] }
    ENV.prepend_path "PATH", buildpath/"node-build/bin"
    ENV["npm_config_cache"] = buildpath/".npm-cache"
    system "npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"
  end

  def install
    ENV.prepend_path "PATH", buildpath/"node-build/bin"
    ENV["npm_config_cache"] = buildpath/".npm-cache"
    resource("bun").stage { (buildpath/"bun-build").install "bun" }
    ENV.prepend_path "PATH", buildpath/"bun-build"
    system "npm", "ci", "--offline", "--ignore-scripts", "--no-audit", "--no-fund"
    system "npm", "run", "build"
    system "npm", "run", "package:binaries"
    bin.install "release/mdview"
    doc.install "THIRD_PARTY_NOTICES.md"
    bash_completion.install "completions/bash/mdview"
    zsh_completion.install "completions/zsh/_mdview"
    fish_completion.install "completions/fish/mdview.fish"
  end

  def caveats
    <<~EOS
      Installation checks executable availability only. Linux rendering needs
      working Bubblewrap namespaces, a reachable systemd user manager, and
      cgroup v2 memory/task controls. Check protection in your login session:
        mdview --no-history /path/to/document.md > /dev/null
      macOS uses private Apple memory APIs and Seatbelt. Unsupported hosts
      refuse rendering; protection is never disabled automatically.
    EOS
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/mdview --version").strip
    (testpath/"document.md").write "# Homebrew render\n\nInstalled from the formula.\n"
    # Homebrew already sandboxes this fixed fixture; CI separately verifies default protection.
    assert_match "Homebrew render", shell_output("#{bin}/mdview --no-sandbox --no-history #{testpath}/document.md")
  end
end
